# Copy to .env and fill in real values. Never commit the real .env.

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/nextstep2?schema=public"

# HTTP server port.
PORT=3000

# Frontend origin allowed to send credentialed requests (cookies). Must be
# an exact origin, never "*", per the cookie-based auth design.
CORS_ORIGIN="http://localhost:5173"

# Secret used to sign/verify JWT access tokens. Generate a real random value
# for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET="dev-only-change-me"

# Set to "false" only for local HTTP development. Must be "true" (or unset —
# it defaults to true) everywhere real traffic is HTTPS.
COOKIE_SECURE="false"

# Phase 0 seed accounts (prisma/seed.ts) — change these before using
# anywhere beyond a local machine.
SEED_ADMIN_EMAIL="admin@nextstep2.dev"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_CONTENT_AUTHOR_EMAIL="author@nextstep2.dev"
SEED_CONTENT_AUTHOR_PASSWORD="ChangeMe123!"
SEED_CONTENT_REVIEWER_EMAIL="reviewer@nextstep2.dev"
SEED_CONTENT_REVIEWER_PASSWORD="ChangeMe123!"
SEED_STUDENT_EMAIL="jordan.smith@nextstep2.dev"
SEED_STUDENT_PASSWORD="ChangeMe123!"

# AI Exercise Evaluation (Slice 2.2) — server-side only, never sent to the
# frontend, never hardcoded in source. RealAiEvaluatorService
# (src/evaluation/evaluators/real-ai-evaluator.service.ts) calls the Claude
# API — kept in the codebase and ready to bind again (see
# evaluation.module.ts) but not currently live, since no Anthropic key is
# available. If unset, every evaluation fails cleanly with status FAILED
# (the student's submission itself is never affected) rather than the
# backend refusing to start — see that file's own doc comment.
ANTHROPIC_API_KEY=""

# Currently-live evaluator: HuggingFaceEvaluatorService
# (src/evaluation/evaluators/huggingface-evaluator.service.ts), a
# development/testing-phase stand-in for the Anthropic evaluator above,
# calling Hugging Face Inference Providers' OpenAI-compatible router. Same
# "unset -> every evaluation FAILs cleanly" behavior as ANTHROPIC_API_KEY.
#
# HF_TOKEN: a fine-grained Hugging Face token with "Make calls to Inference
# Providers" permission — create one at
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
#
# HF_MODEL: an instruction-following, code-capable chat-completion model
# currently served by Inference Providers. Verified available and
# recommended for this use case as of this writing:
#   Qwen/Qwen2.5-Coder-32B-Instruct
# Optionally append ":<provider>" (e.g. ":together") to pin a specific
# Inference Provider, or ":cheapest"/":fastest" to pick a selection policy —
# see https://huggingface.co/docs/inference-providers. Bare model id
# defaults to ":fastest".
HF_TOKEN=""
HF_MODEL="Qwen/Qwen2.5-Coder-32B-Instruct"

# ---------------------------------------------------------------------------
# AI Evaluation Reliability (background worker) — see
# src/evaluation/evaluation-config.ts for the single source of truth on
# these defaults and the reasoning behind each one. All optional; every
# value below is what's used if the variable is unset or blank.
# ---------------------------------------------------------------------------

# Max evaluations in flight at once, across this whole process. Conservative
# default for a ~100-student target talking to a third-party-routed open
# model whose real rate limits we haven't measured — see the reliability
# slice's load-test report before raising this.
EVALUATION_CONCURRENCY=5

# How often the worker checks for new/due work when it isn't already at full
# concurrency (milliseconds). Freed slots are also reused immediately when
# an evaluation finishes, independent of this interval.
EVALUATION_POLL_INTERVAL_MS=2000

# Hard ceiling on one provider call (milliseconds) — an evaluation that
# doesn't respond within this is treated as a timeout (retried within the
# bounded retry policy below, then FAILED).
AI_EVALUATION_TIMEOUT_MS=45000

# Bounded retry policy for transient failures only (network errors, provider
# 5xx, rate limits, timeouts) — never applied to invalid AI JSON, schema
# validation failures, or configuration errors, which fail immediately.
AI_EVALUATION_MAX_RETRIES=3
AI_EVALUATION_RETRY_BASE_DELAY_MS=2000
AI_EVALUATION_RETRY_MAX_DELAY_MS=30000

# An EVALUATING row older than this (milliseconds) is assumed abandoned
# (the worker that claimed it crashed mid-attempt) and becomes eligible for
# another worker to reclaim. Comfortably larger than AI_EVALUATION_TIMEOUT_MS
# plus normal overhead so a merely-slow-but-alive attempt is never falsely
# reclaimed out from under itself.
AI_EVALUATION_STALE_MS=120000

# Defense-in-depth input limits enforced right before the LLM call (on top
# of, not instead of, CreateSubmissionDto's own per-file/file-count
# validation at submit time) — protects the evaluator specifically from a
# technically-valid-but-oversized submission. Exceeding either FAILs the
# evaluation immediately (submission itself is untouched) rather than
# silently truncating code, which could produce misleading grading.
AI_EVALUATION_MAX_FILES=50
AI_EVALUATION_MAX_TOTAL_INPUT_CHARS=50000
